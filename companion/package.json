{
  "name": "spicysidequests",
  "version": "0.3.1",
  "description": "Optional companion for the Spicy Side Quests addon: syncs a markdown todo file with the game.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "node src/index.ts",
    "once": "node src/index.ts --once",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:exe": "bun build src/index.ts --compile --target=bun-windows-x64 --outfile dist/spicysidequests.exe"
  }
}
